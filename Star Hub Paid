	18139512873,
}
local GPO = { 6360478118, 7465136166, 3978370137, 6811831486, 11424731604, 1730877806 }

local function any(list, v)
	for _, x in ipairs(list) do
		if x == v then
			return true
		end
	end
	return false
end

local url
if pid == 9391468976 or cid == 16357742 then
	url = "https://api.luarmor.net/files/v4/loaders/5aad91ee145a10ec5e4ad4dd417e28e2.lua"
elseif any(DEEPWOKEN, pid) then
	url = "https://api.luarmor.net/files/v4/loaders/dd135aeac44f3ac5c2ad8bad1cc0b608.lua"
elseif pid == 14070029709 or cid == 32740991 then
	url = "https://api.luarmor.net/files/v3/loaders/7a4539aa1a2b38f9ee43b6eda9540245.lua"
elseif any(GPO, pid) or cid == 3229308 then
	url = "https://api.luarmor.net/files/v4/loaders/ca897262655eaecb153ae7f01f81bc8b.lua"
end

if not url then
	return
end

if not game:IsLoaded() then
	game.Loaded:Wait()
end

local Players = game:GetService("Players")
repeat
	task.wait()
until Players.LocalPlayer

local function readKey()
	local k = script_key
	if type(k) ~= "string" or #k < 10 then
		pcall(function()
			k = getgenv().script_key
		end)
	end
	if type(k) ~= "string" or #k < 10 then
		k = rawget(_G, "script_key")
	end
	if type(k) ~= "string" or #k < 10 then
		return nil
	end
	return (string.gsub(k, "%s", ""))
end

local key = readKey()
local keyWaited = os.clock()
while not key and os.clock() - keyWaited < 3 do
	task.wait(0.25)
	key = readKey()
end

local function notify(text)
	pcall(function()
		game:GetService("StarterGui"):SetCore("SendNotification", {
			Title = "Star Hub",
			Text = text,
			Duration = 15,
		})
	end)
end

if not key then
	notify("No key found. Put script_key=\"YOUR KEY\" on the first line.")
	return
end

script_key = key
pcall(function()
	getgenv().script_key = key
end)

local scriptId = string.match(url, "loaders/(%x+)%.lua")
local okLib, api = pcall(function()
	return loadstring(game:HttpGet("https://sdkapi-public.luarmor.net/library.lua"))()
end)

if scriptId and okLib and type(api) == "table" and type(api.check_key) == "function" then
	api.script_id = scriptId

	local status = nil
	for attempt = 1, 4 do
		local okCheck, result = pcall(api.check_key, key)
		if okCheck and type(result) == "table" then
			status = result
			local code = result.code
			if code ~= "UNKNOWN_ERROR" and code ~= "TIME_ERROR" and code ~= "SECURITY_ERROR" then
				break
			end
		end
		task.wait(attempt)
	end

	if status and status.code ~= "KEY_VALID" then
		notify(string.format("Key check: %s (%s)", tostring(status.code), tostring(status.message)))
		if
			status.code == "KEY_INVALID"
			or status.code == "KEY_INCORRECT"
			or status.code == "KEY_EXPIRED"
			or status.code == "KEY_BANNED"
			or status.code == "KEY_HWID_LOCKED"
		then
			return
		end
	end
end

pcall(function()
	if getgenv then
		getgenv().STAR_LOADER_URL = url
	end
end)

for attempt = 1, 5 do
	if shared and shared.StarHub then
		return
	end

	local ok, res = pcall(game.HttpGet, game, url)

	if ok and type(res) == "string" and #res > 100 then
		local chunk = loadstring(res)

		if chunk then
			pcall(chunk)
			return
		end
	end

	task.wait(attempt)
end
