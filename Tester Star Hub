	18139512873,
}
local GPO = { 6360478118, 7465136166, 3978370137, 6811831486, 11424731604, 1730877806 }

local function any(list, v)
	for _, x in ipairs(list) do
		if x == v then
			return true
		end
	end
	return false
end

local url
if pid == 9391468976 or cid == 16357742 then
	url = "https://api.luarmor.net/files/v4/loaders/d074cb926596a65c2c73d2965d9c109f.lua"
elseif any(DEEPWOKEN, pid) then
	url = "https://api.luarmor.net/files/v4/loaders/d4a4f7529eab314d5e1ce506ef250113.lua"
elseif pid == 14070029709 or cid == 32740991 then
	url = "https://api.luarmor.net/files/v3/loaders/3ae81135112eac39e25b6e063819b93a.lua"
elseif any(GPO, pid) or cid == 3229308 then
	url = "https://api.luarmor.net/files/v4/loaders/86e40a0d18b507addd1e13c9bca8864f.lua"
end

if not url then
	return
end

if not game:IsLoaded() then
	game.Loaded:Wait()
end

local Players = game:GetService("Players")
repeat
	task.wait()
until Players.LocalPlayer

pcall(function()
	local k = script_key or (getgenv and getgenv().script_key)
	if k then
		script_key = k
		if getgenv then
			getgenv().script_key = k
		end
	end
end)

pcall(function()
	if getgenv then
		getgenv().STAR_LOADER_URL = url
	end
end)

for attempt = 1, 5 do
	if shared and shared.StarHub then
		return
	end

	local ok, res = pcall(game.HttpGet, game, url)

	if ok and type(res) == "string" and #res > 100 then
		local chunk = loadstring(res)

		if chunk then
			pcall(chunk)
			return
		end
	end

	task.wait(attempt)
end
